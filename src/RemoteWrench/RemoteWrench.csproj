<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
  </PropertyGroup>

  <!--
  PowerShell provides System.Management.Automation at runtime, only the
  reference assembly is needed to compile and none of the package or its
  dependencies end up in the published module.
  -->
  <ItemGroup>
    <!-- Run in the remote session by Enter-ExtSession. -->
    <EmbeddedResource Include="Ext/ExtServer.ps1" LogicalName="RemoteWrench.Ext.ExtServer.ps1" />
    <EmbeddedResource Include="Ext/Builtin/*.ps1" LogicalName="RemoteWrench.Ext.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- AssemblyLoadContext only exists on .NET, Windows PowerShell imports the module assembly directly. -->
    <ProjectReference Include="../RemoteWrench.Loader/RemoteWrench.Loader.csproj" />
    <PackageReference Include="System.Management.Automation" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="PowerShellStandard.Library" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="System.Memory" />
  </ItemGroup>
</Project>
